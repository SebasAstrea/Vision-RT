<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/settings_title"
            style="@style/VisionRT.TextView.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title" />

        <TextView
            android:id="@+id/verbosity_title"
            style="@style/VisionRT.TextView.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_verbosity_title" />

        <RadioGroup
            android:id="@+id/verbosity_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/verbosity_minimal"
                style="@style/VisionRTRadioButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_verbosity_minimal" />

            <RadioButton
                android:id="@+id/verbosity_normal"
                style="@style/VisionRTRadioButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_verbosity_normal" />

            <RadioButton
                android:id="@+id/verbosity_detailed"
                style="@style/VisionRTRadioButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_verbosity_detailed" />
        </RadioGroup>

        <TextView
            android:id="@+id/section_speech_rate"
            style="@style/VisionRT.TextView.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_speech_rate_title" />

        <TextView
            android:id="@+id/speech_rate_value"
            style="@style/VisionRT.TextView.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_speech_rate_default" />

        <SeekBar
            android:id="@+id/speech_rate_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/settings_speech_rate_title"
            android:max="30"
            android:progress="10" />

        <TextView
            android:id="@+id/section_haptics"
            style="@style/VisionRT.TextView.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_haptics_title" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/haptics_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/settings_haptics_enable"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/haptics_warning"
            style="@style/VisionRT.TextView.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/settings_haptics_warning"
            android:visibility="gone" />

        <TextView
            android:id="@+id/haptic_intensity_title"
            style="@style/VisionRT.TextView.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_haptic_intensity_title" />

        <RadioGroup
            android:id="@+id/haptic_intensity_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/haptic_intensity_light"
                style="@style/VisionRTRadioButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_haptic_intensity_light" />

            <RadioButton
                android:id="@+id/haptic_intensity_medium"
                style="@style/VisionRTRadioButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_haptic_intensity_medium" />

            <RadioButton
                android:id="@+id/haptic_intensity_strong"
                style="@style/VisionRTRadioButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_haptic_intensity_strong" />
        </RadioGroup>

        <TextView
            android:id="@+id/section_earcons"
            style="@style/VisionRT.TextView.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_earcons_title" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/earcons_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/settings_earcons_enable"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/section_device_profile"
            style="@style/VisionRT.TextView.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_device_profile" />

        <TextView
            android:id="@+id/device_profile_value"
            style="@style/VisionRT.TextView.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_device_profile" />

        <TextView
            android:id="@+id/section_replay"
            style="@style/VisionRT.TextView.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_replay_training" />

        <TextView
            android:id="@+id/replay_desc"
            style="@style/VisionRT.TextView.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_replay_training_desc" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/replay_training_button"
            style="@style/VisionRT.Button.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/settings_replay_training"
            android:text="@string/settings_replay_training" />

        <TextView
            android:id="@+id/section_benchmark"
            style="@style/VisionRT.TextView.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_run_benchmark" />

        <TextView
            android:id="@+id/benchmark_desc"
            style="@style/VisionRT.TextView.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_run_benchmark_desc" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/run_benchmark_button"
            style="@style/VisionRT.Button.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/settings_run_benchmark"
            android:text="@string/settings_run_benchmark" />

        <TextView
            android:id="@+id/benchmark_result"
            style="@style/VisionRT.TextView.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/run_ocr_benchmark_button"
            style="@style/VisionRT.Button.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/settings_run_ocr_benchmark"
            android:text="@string/settings_run_ocr_benchmark" />

        <TextView
            android:id="@+id/ocr_benchmark_desc"
            style="@style/VisionRT.TextView.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_run_ocr_benchmark_desc" />

        <TextView
            android:id="@+id/ocr_benchmark_result"
            style="@style/VisionRT.TextView.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="" />
    </LinearLayout>
</ScrollView>
