<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/text_reading_title"
            style="@style/VisionRT.TextView.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mode_text_reading" />

        <TextView
            android:id="@+id/text_reading_status"
            style="@style/VisionRT.TextView.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:text="@string/ocr_status_idle"
            tools:ignore="UnusedAttribute" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ocr_start_button"
            style="@style/VisionRT.Button.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/ocr_start" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ocr_repeat_button"
            style="@style/VisionRT.Button.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ocr_repeat" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ocr_next_button"
            style="@style/VisionRT.Button.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ocr_next" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ocr_stop_button"
            style="@style/VisionRT.Button.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ocr_stop" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ocr_back_button"
            style="@style/VisionRT.Button.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/common_back" />
    </LinearLayout>
</ScrollView>
